PORT=3099
NODE_ENV=development

# Database connection URL (PostgreSQL)
# When running inside Docker container with host postgres:
# DATABASE_URL="postgresql://postgres:123@host.docker.internal:5432/monitor_err"
DATABASE_URL="postgresql://postgres:123@localhost:5432/monitor_err"
DIRECT_URL="postgresql://postgres:123@localhost:5432/monitor_err"

# Admin credentials for seeding
ADMIN_EMAIL=admin@widya.com
ADMIN_NAME="Super Admin"
ADMIN_PASSWORD=admin123
